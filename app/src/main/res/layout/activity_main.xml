<?xml version="1.0" encoding="utf-8"?>
<!-- No backgrounds anywhere on the home path: the wallpaper shows through untouched. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- Full-bleed scrim (behind status/nav bars too); only visible with the drawer open. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingTop="@dimen/page_padding_top"
            android:paddingEnd="@dimen/page_padding_h"
            android:paddingBottom="@dimen/page_padding_bottom">

            <TextView
                android:id="@+id/clock"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/date"
                style="@style/HomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="16sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Optional search line: text + 1dp rule, no background. Tap = drawer + keyboard. -->
            <LinearLayout
                android:id="@+id/home_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/home_search_text"
                    style="@style/HomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:text="@string/home_search"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/home_search_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:alpha="0.4" />
            </LinearLayout>
        </LinearLayout>

        <!-- Drawer is inflated lazily (idle after first frame) to keep cold start lean. -->
        <ViewStub
            android:id="@+id/drawer_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inflatedId="@+id/drawer"
            android:layout="@layout/drawer" />

        <!-- Notes page (swipe right). Inflated only the first time it's opened. -->
        <ViewStub
            android:id="@+id/notes_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inflatedId="@+id/notes"
            android:layout="@layout/notes" />

        <!-- Widgets page (swipe left). Inflated only the first time it's opened. -->
        <ViewStub
            android:id="@+id/widgets_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inflatedId="@+id/widgets"
            android:layout="@layout/widgets" />
    </FrameLayout>
</merge>
