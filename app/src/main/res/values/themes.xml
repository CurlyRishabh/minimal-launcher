<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher never paints a background: the wallpaper (static or live) shows through
         and is composited by the system, so it costs the launcher nothing to render. -->
    <style name="Base.Theme.Minimal" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Transparent (fully see-through) status and navigation bars; content is laid out
             behind them in MainActivity and padded via fitsSystemWindows. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <style name="Theme.Minimal" parent="Base.Theme.Minimal" />

    <!-- Settings: same wallpaper, dark scrim for readability. -->
    <style name="Theme.Minimal.Settings">
        <item name="android:windowBackground">@color/scrim</item>
    </style>

    <!-- One family (system sans), two weights: regular and light. -->
    <style name="HomeText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:shadowColor">@color/shadow_on_light_text</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDy">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
